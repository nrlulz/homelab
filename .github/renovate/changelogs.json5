{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDepNames": [
        "/actualbudget/actual/"
      ],
      "sourceUrl": "https://github.com/actualbudget/actual"
    },
    {
      "matchDepNames": [
        "argo-cd"
      ],
      "sourceUrl": "https://github.com/argoproj/argo-helm",
      "sourceDirectory": "charts/argo-cd"
    },
    {
      "matchDepNames": [
        "/coder/code-server/"
      ],
      "sourceUrl": "https://github.com/coder/code-server"
    },
    {
      "matchDepNames": [
        "/crocodilestick/calibre-web-automated/"
      ],
      "sourceUrl": "https://github.com/crocodilestick/Calibre-Web-Automated"
    },
    {
      "matchDepNames": [
        "/dagandersen/argocd-diff-preview/"
      ],
      "sourceUrl": "https://github.com/dag-andersen/argocd-diff-preview"
    },
    {
      "matchDepNames": [
        "grafana"
      ],
      "sourceUrl": "https://github.com/grafana-community/helm-charts",
      "sourceDirectory": "charts/grafana"
    },
    {
      "matchDepNames": [
        "/jellyfin/jellyfin/"
      ],
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchDepNames": [
        "/kindest/node/",
        "/siderolabs/kubelet/"
      ],
      "sourceUrl": "https://github.com/kubernetes/kubernetes"
    },
    {
      "matchDepNames": [
        "loki"
      ],
      "sourceUrl": "https://github.com/grafana-community/helm-charts",
      "sourceDirectory": "charts/loki"
    },
    {
      "matchDepNames": [
        "longhorn"
      ],
      "sourceUrl": "https://github.com/longhorn/longhorn"
    },
    {
      "matchDepNames": [
        "/maziggy/bambuddy/"
      ],
      "sourceUrl": "https://github.com/maziggy/bambuddy"
    },
    {
      "matchDepNames": [
        "/plexinc/pms-docker/"
      ],
      "changelogUrl": "https://forums.plex.tv/t/plex-media-server/30447"
    },
    {
      "matchDepNames": [
        "plugin-barman-cloud"
      ],
      "sourceUrl": "https://github.com/cloudnative-pg/charts",
      "sourceDirectory": "charts/plugin-barman-cloud",
      "changelogUrl": "https://github.com/cloudnative-pg/charts/releases?q=plugin-barman-cloud&expanded=true"
    },
    {
      "matchDepNames": [
        "prometheus"
      ],
      "sourceUrl": "https://github.com/prometheus-community/helm-charts",
      "sourceDirectory": "charts/prometheus"
    },
    {
      "matchDepNames": [
        "promtail"
      ],
      "sourceUrl": "https://github.com/grafana/helm-charts",
      "sourceDirectory": "charts/promtail"
    },
    {
      "matchDepNames": [
        "/psybers/actual-helpers/"
      ],
      "changelogUrl": "https://github.com/psybers/actual-helpers/commits/main/"
    },
    {
      "matchDepNames": [
        "reloader"
      ],
      "changelogUrl": "https://github.com/stakater/Reloader/releases?q=chart-v&expanded=true"
    },
    {
      "matchDepNames": [
        "/rhasspy/wyoming-piper/"
      ],
      "sourceUrl": "https://github.com/OHF-Voice/wyoming-piper"
    },
    {
      "matchDepNames": [
        "/rhasspy/wyoming-whisper/"
      ],
      "sourceUrl": "https://github.com/OHF-Voice/wyoming-faster-whisper"
    }
  ]
}
